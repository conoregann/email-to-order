APP_NAME=Email to Order
# Empty uses .local/orders.db. PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://user:password@host/database?sslmode=require
DATABASE_URL=
# Optional direct PostgreSQL URL for migrations; Neon deploy supplies this.
DATABASE_URL_UNPOOLED=
COOKIE_SECURE=false
GEMINI_API_KEY=
# Live calls stay off until model support, free-tier eligibility and project quotas/billing are verified.
GEMINI_MODEL=
EXTRACTION_ENABLED=false
# Lower these if project quotas require it; ceilings are 5 per guest and 25 globally.
EXTRACTION_GUEST_LIMIT=5
EXTRACTION_DAILY_LIMIT=25
EXTRACTION_TIMEOUT_SECONDS=30

# Public safeguards: values may be lowered, but cannot exceed these defaults.
REQUEST_BODY_LIMIT=131072
# Per minute; includes failed and oversized API requests.
API_ADDRESS_LIMIT=120
API_GLOBAL_LIMIT=1200
# Workspace creations per hour; independent of cookies.
GUEST_ADDRESS_LIMIT=5
GUEST_GLOBAL_LIMIT=100
# Total retained workspaces, including expired ones; no automatic deletion.
WORKSPACE_LIMIT=1000
# User-created records per workspace; built-in samples are excluded.
WORKSPACE_ORDER_LIMIT=100
WORKSPACE_CUSTOMER_LIMIT=100
WORKSPACE_PRODUCT_LIMIT=100
